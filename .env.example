# ==========================================
# HyperX Terminal Environment Configuration
# ==========================================

# ------------------------------------------
# Database (PostgreSQL)
# ------------------------------------------
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DB?schema=public"

# ------------------------------------------
# Redis (Upstash or local)
# ------------------------------------------
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""
# Or for local Redis:
# REDIS_URL="redis://localhost:6379"

# ------------------------------------------
# Authentication (JWT)
# ------------------------------------------
# Required: Generate with: openssl rand -base64 32
JWT_SECRET=""
JWT_REFRESH_SECRET=""
# Optional: Cookie signing (defaults to JWT_SECRET if not set)
COOKIE_SECRET=""

# ------------------------------------------
# Starknet Configuration
# ------------------------------------------
# Mainnet or Sepolia RPC endpoint
STARKNET_RPC_URL="https://starknet-mainnet.public.blastapi.io"
STARKNET_CHAIN_ID="SN_MAIN"

# Frontend Starknet config
VITE_STARKNET_RPC_URL="https://starknet-mainnet.public.blastapi.io"
VITE_STARKNET_NETWORK="mainnet"
# Optional: Paymaster for gasless transactions
VITE_PAYMASTER_URL=""

# ------------------------------------------
# API Server
# ------------------------------------------
PORT="3001"
NODE_ENV="development"

# ------------------------------------------
# WebSocket Server
# ------------------------------------------
WS_PORT="3002"

# ------------------------------------------
# Extended DEX Integration
# ------------------------------------------
EXTENDED_WS_URL=""
EXTENDED_REST_URL=""
EXTENDED_API_URL=""
EXTENDED_API_KEY=""
EXTENDED_API_SECRET=""
EXTENDED_CHAIN_ID="1"

# ------------------------------------------
# Paradex DEX Integration
# ------------------------------------------
# Use testnet for development
PARADEX_API_URL="https://api.testnet.paradex.trade"
PARADEX_REST_URL="https://api.testnet.paradex.trade"
PARADEX_WS_URL="wss://ws.testnet.paradex.trade"
PARADEX_WS_ENABLED="true"
# L1 Starknet chain ID (1=mainnet, 11155111=sepolia)
PARADEX_CHAIN_ID="11155111"

# Authentication (one of these required for trading):
# Option 1: Starknet account for signing
PARADEX_STARKNET_ADDRESS=""
PARADEX_STARKNET_PRIVATE_KEY=""
# Option 2: JWT token for read-only access
PARADEX_JWT_TOKEN=""

# ------------------------------------------
# Frontend URLs (for local development)
# ------------------------------------------
VITE_API_URL="http://localhost:3001"
VITE_WS_URL="ws://localhost:3002"
