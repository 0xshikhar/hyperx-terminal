{
  "name": "@hyperx/api",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "set -a; [ -f ../../.env ] && . ../../.env; set +a; prisma generate && node --import=tsx src/index.ts",
    "build": "prisma generate && tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "prisma:generate": "set -a; [ -f ../../.env ] && . ../../.env; set +a; prisma generate",
    "prisma:migrate": "set -a; [ -f ../../.env ] && . ../../.env; set +a; prisma migrate dev",
    "prisma:deploy": "set -a; [ -f ../../.env ] && . ../../.env; set +a; prisma migrate deploy",
    "prisma:studio": "set -a; [ -f ../../.env ] && . ../../.env; set +a; prisma studio"
  },
  "dependencies": {
    "@fastify/cors": "^11.0.1",
    "@fastify/helmet": "^13.0.1",
    "@prisma/client": "^6.19.0",
    "@upstash/redis": "^1.35.3",
    "dotenv": "^17.0.0",
    "fastify": "^5.6.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^22.19.15",
    "prisma": "^6.19.0",
    "tsx": "^4.20.5",
    "typescript": "~5.9.3"
  }
}
